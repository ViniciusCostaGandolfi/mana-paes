# ==============================================================================
# Mana Paes — Variáveis de Ambiente (EXEMPLO)
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env` (na raiz) e preencha TODOS os valores.
# O `.env` está no .gitignore — nunca commitar segredos reais.
#
# IMPORTANTE: os dois docker-compose (docker-compose.yaml e
# docker-compose.dev.yaml) leem TODAS as variáveis deste .env SEM fallback.
# Se alguma variável faltar no .env, o `docker compose config` falha.
# Os valores abaixo são apenas EXEMPLOS — ajuste conforme o ambiente.
# ==============================================================================

# ------------------------------------------------------------------------------
# Spring (perfil ativo — docker-compose.yaml fixa "prod"; o dev fixa "dev")
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=manapaes
DB_USER=manapaes
# Produção: gere um valor forte. Ex.: openssl rand -hex 32
DB_PASSWORD=manapaes

# ------------------------------------------------------------------------------
# RabbitMQ (fila de notificações)
# ------------------------------------------------------------------------------
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=manapaes
RABBIT_PASSWORD=manapaes

# ------------------------------------------------------------------------------
# SMTP (e-mail transacional)
#   - dev  -> mailpit (SMTP na porta 1025, UI em http://localhost:8025)
#   - prod -> seu provedor real (ex: smtp.gmail.com:587)
# ------------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true envia e-mails de verdade (dev: capturados pelo mailpit); false apenas loga
MAIL_ENABLED=true

# ------------------------------------------------------------------------------
# JWT — OBRIGATÓRIO (mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-minimo-32-caracteres-0123456789

# ------------------------------------------------------------------------------
# Criptografia de secrets (token da Evolution no banco) — OBRIGATÓRIO
# Gere com: openssl rand -hex 32
# ------------------------------------------------------------------------------
APP_ENCRYPTION_MASTER_KEY=change-me-master-key-minimo-32-caracteres

# ------------------------------------------------------------------------------
# Evolution API (WhatsApp)
#   - Vazio          -> MOCK ativo (nenhuma chamada externa; simular scan em dev)
#   - Preenchido     -> serviço REAL (cria instância, QR code, webhook)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Nome base das instancias da Evolution API. E UMA instancia POR ADMIN:
#  - em producao, a instancia de cada admin e auto-criada com nome derivado
#    <EVOLUTION_INSTANCE_NAME>-<userId> ao clicar em "Conectar WhatsApp";
#  - em dev, o seed pre-cadastra a conexao do admin (Breno) com ESTA instancia.
EVOLUTION_INSTANCE_NAME=mana-paes
# true = imprime mensagens no console em vez de enviar pelo WhatsApp (dev).
# false = envia de verdade pela Evolution API (produção).
EVOLUTION_MOCK_SEND=false

# URL pública do backend (usada para registrar o webhook da Evolution)
#   - dev  -> http://localhost:8080
#   - prod -> https://api.seudominio.com.br
APP_BACKEND_URL=http://localhost:8080

# URL pública do frontend (usada para CORS e links de e-mail)
#   - dev  -> http://localhost:3000
#   - prod -> https://seudominio.com.br
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Flags de recurso
# ------------------------------------------------------------------------------
# true = consome fila RabbitMQ e dispara notificações (Evolution/email)
NOTIFICATIONS_ENABLED=true
# true = agenda o relatório diário (horário configurado por tenant)
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------------------
# Frontend (build do mana-paes-web)
# ------------------------------------------------------------------------------
# URL base da API embutida no bundle (Vite). É a baseURL direta do axios, então
# precisa incluir o prefixo /api/v1. Em dev: http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# Coolify (opcional, usado apenas por ferramentas/CI — não é do app)
# ------------------------------------------------------------------------------
# COOLIFY_URL=https://painel.gradehorarios.com.br
# COOLIFY_TOKEN=